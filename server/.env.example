PORT=3001

# Local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nomnom

# Railway (ưu tiên — Variables service nomnom):
# MYSQL_URL=${{MySQL.MYSQL_URL}}
# Hoặc từng biến (phải khớp 100% Variables của service MySQL):
